FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DATA_DIR=/data \
    PORT=8080

WORKDIR /app

# In Portainer unter "Select files" diese beiden Dateien auswählen:
# app/amazon_product_watch.py und app/icon.svg
COPY amazon_product_watch.py icon.svg ./

RUN pip install --no-cache-dir tzdata && mkdir -p /data

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3)"]

CMD ["python", "amazon_product_watch.py"]
