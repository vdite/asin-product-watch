# Amazon Creators API (for Germany, credential version is normally 3.2)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.de

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Optional defaults
DEFAULT_CHECK_INTERVAL_MINUTES=60
MAX_WATCHLIST_SIZE=500
TZ=Europe/Berlin
